VITE_API_BASE_URL="http://localhost:3011/api/v1"

# Kok domain (www.pilens.com.tr / pilens.com.tr) - "/" rotasinin, oturum yoksa /login'e
# atmak yerine tanitim sayfasini (LandingPage) gostermesi icin kullanilir. Yerel
# gelistirmede bos birakilabilir; birden fazla host (orn. farkli LAN IP'leri) icin
# virgulle ayirarak birden fazla deger girilebilir (bkz. src/lib/root-domain.ts).
VITE_TENANT_ROOT_DOMAIN=""

# Tanitim sayfasindaki "Demo Iste" formunun gonderdigi web3forms.com public access key'i.
# web3forms.com'da ucretsiz hesap acip olusturulan key buraya yazilir - gizli bir sunucu
# sirri degildir, client-side kullanim icin tasarlanmistir.
VITE_WEB3FORMS_ACCESS_KEY=""

# Suresi dolan demo hesabi modal'inda "Bizi arayin" olarak gosterilen telefon numarasi
# (orn. "0212 000 00 00"). Bos birakilirsa sadece "Beni arayin" talep formu gorunur.
VITE_DEMO_CONTACT_PHONE=""
